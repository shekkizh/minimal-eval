# Provider credentials
API_KEY=

# Sandbox provider: vercel (default) or modal
MINIEVAL_SANDBOX=vercel

# Required when using Vercel Sandbox
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Team that owns the project (when applicable)
# VERCEL_TEAM_ID=

# Modal: authenticate with `modal token set --profile=...`, or set tokens below.
# MODAL_PROFILE=...
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Provider endpoint (example agent uses the chat completions API)
# BASE_URL=https://ai-gateway.vercel.sh/v1
